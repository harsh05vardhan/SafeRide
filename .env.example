# ============================================================
# SafeRide - environment variable reference (development values)
# Copy to .env and fill in real values for your machine. NEVER commit
# a real .env file - it is git-ignored on purpose.
#
# docker-compose.dev.yml and the backend's application.yml both read
# these (with safe local defaults baked in for zero-config first run).
# ============================================================

# ---- Database (MySQL) ----
DB_URL=jdbc:mysql://localhost:3306/saferide?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_NAME=saferide
DB_USERNAME=saferide
DB_PASSWORD=saferide
DB_ROOT_PASSWORD=saferide_root

# ---- JWT (introduced Phase 2) ----
# Generate a strong random value for real use, e.g.: openssl rand -base64 64
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ---- Redis (Phase 11 - driver geo-index for matching, login rate limiting) ----
REDIS_HOST=localhost
REDIS_PORT=6379
# "redis" (default) or "sql"/"in-memory" respectively - see application.yml's comments on
# app.matching.geo-index-source / app.security.login-rate-limit.source for what each means.
MATCHING_GEO_INDEX_SOURCE=redis
LOGIN_RATE_LIMIT_SOURCE=redis

# ---- Maps (MockMapService is used until a real key is supplied) ----
MAP_API_KEY=

# ---- Payments (MockPaymentService is used until a real key is supplied) ----
PAYMENT_API_KEY=

# ---- Backend ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Frontend (saferide-frontend/.env - VITE_ prefix required by Vite) ----
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_BASE_URL=ws://localhost:8080/ws
